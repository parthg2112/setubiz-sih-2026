# Copy to .env. Every value has a working default — the app runs with this file absent.

# --- feasibility ---
SETUBIZ_DEFAULT_RADIUS_KM=10
SETUBIZ_COMPETITOR_ESTIMATOR=ec13_zscore   # ec13_zscore | lightgbm_density (not trained yet)
SETUBIZ_DEMAND_ESTIMATOR=hces_mean_band

# --- decision layer (auditable; change these and say so in the report) ---
SETUBIZ_DSCR_THRESHOLD=1.5                 # NABARD appraisal norm
SETUBIZ_STRESS_DSCR_FLOOR=1.0              # a recommended loan must survive a -15% year
SETUBIZ_ENFORCE_STRESS_FLOOR=true
SETUBIZ_RECOMMENDED_LOAN_STEP=1000

# --- language layer (off by default; the template narrator is the demo lane) ---
SETUBIZ_LLM_ENABLED=false
SETUBIZ_LLM_MODEL=claude-opus-5
SETUBIZ_LLM_EFFORT=low
SETUBIZ_LLM_MAX_ATTEMPTS=3
SETUBIZ_ANTHROPIC_API_KEY=

# --- frontend ---
# Where `npm run dev` proxies /api. Only needed if the API is not on port 8000.
# SETUBIZ_API=http://localhost:8010
